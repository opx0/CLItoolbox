# MongoDB
MONGO_CONTAINER_NAME=academyos-mongodb
MONGO_PORT=27017
MONGO_INITDB_DATABASE=academyos

# Optional: enable MongoDB authentication (set both)
# MONGO_INITDB_ROOT_USERNAME=admin
# MONGO_INITDB_ROOT_PASSWORD=change-me

# Mongo Express
MONGO_EXPRESS_CONTAINER_NAME=mongo-express
MONGO_EXPRESS_PORT=8081
ME_CONFIG_MONGODB_URL=mongodb://mongodb:27017/
ME_CONFIG_BASICAUTH_USERNAME=webuser
ME_CONFIG_BASICAUTH_PASSWORD=webpass

# If MongoDB auth is enabled, use a URL like:
# ME_CONFIG_MONGODB_URL=mongodb://admin:change-me@mongodb:27017/?authSource=admin
